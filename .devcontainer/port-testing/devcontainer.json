{
  "name": "Steam validation env — port testing (multi-distro)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "codespace",
  "updateRemoteUserUID": true,
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC (Steam)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash .devcontainer/port-testing/post-create.sh",
  "runArgs": [
    "--cap-add=SYS_PTRACE",
    "--cap-add=SYS_ADMIN",
    "--security-opt=seccomp=unconfined",
    "--security-opt=apparmor=unconfined",
    "--shm-size=2g"
  ]
}
